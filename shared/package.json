{
  "name": "@neon-strike/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./network": {
      "types": "./dist/network/protocol.d.ts",
      "default": "./dist/network/protocol.js"
    },
    "./match": {
      "types": "./dist/match/MatchManager.d.ts",
      "default": "./dist/match/MatchManager.js"
    },
    "./bots": {
      "types": "./dist/bots/index.d.ts",
      "default": "./dist/bots/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./maps": {
      "types": "./dist/maps/index.d.ts",
      "default": "./dist/maps/index.js"
    },
    "./physics": {
      "types": "./dist/physics/createMapWorld.d.ts",
      "default": "./dist/physics/createMapWorld.js"
    },
    "./hud": {
      "types": "./dist/gameplay/hud.d.ts",
      "default": "./dist/gameplay/hud.js"
    },
    "./gameplay": {
      "types": "./dist/gameplay/index.d.ts",
      "default": "./dist/gameplay/index.js"
    },
    "./simulation": {
      "types": "./dist/simulation/index.d.ts",
      "default": "./dist/simulation/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "ngraph.graph": "^20.1.2",
    "ngraph.path": "^1.6.1"
  }
}
